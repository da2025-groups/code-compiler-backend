FROM ghcr.io/engineer-man/piston

# Replace isolate with a no-sandbox wrapper.
# Linux clone() namespaces fail under QEMU x86_64 on macOS ARM.
COPY isolate-nosec.py /usr/local/bin/isolate
RUN chmod +x /usr/local/bin/isolate

# Custom entrypoint: starts piston then auto-installs required runtimes.
COPY scripts/piston-entrypoint.sh /piston-entrypoint.sh
RUN chmod +x /piston-entrypoint.sh

ENTRYPOINT ["/piston-entrypoint.sh"]
